{
  "name": "@shinro/root",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for Shinro, opinionated file-based routing for Hono with end-to-end type safety.",
  "license": "MIT",
  "author": "Arik Chakma <arikchangma@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arikchakma/shinro.git"
  },
  "type": "module",
  "scripts": {
    "build": "vp run -r build",
    "dev": "vp run @shinro/api#dev",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix --fix-suggestions --fix-dangerously",
    "prepare": "vp config",
    "release": "vp run --filter shinro release"
  },
  "devDependencies": {
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.16.0"
}
