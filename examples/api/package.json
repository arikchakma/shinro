{
  "name": "@shinro/api",
  "version": "0.0.0",
  "private": true,
  "description": "Runnable Hono API showcasing every Shinro route authoring convention.",
  "type": "module",
  "imports": {
    "#shinro/routes": "./.shinro/routes.ts",
    "#shinro/client": "./.shinro/client.ts"
  },
  "exports": {
    "./client": "./.shinro/client.ts"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp run generate && vp check",
    "dev": "node --watch --watch-preserve-output --import shinro/watch src/server.ts",
    "generate": "vp run shinro#build && node node_modules/shinro/dist/cli.mjs generate",
    "prepare": "vp run generate",
    "start": "node dist/server.mjs",
    "test": "vp run generate && vp test"
  },
  "dependencies": {
    "@hono/node-server": "catalog:",
    "@hono/zod-validator": "catalog:",
    "hono": "^4.10.0",
    "shinro": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  }
}
