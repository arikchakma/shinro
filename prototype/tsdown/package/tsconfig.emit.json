{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmit": false,
    "rewriteRelativeImportExtensions": true,
    "outDir": "${configDir}/dist",
    "declaration": true,
    "sourceMap": true
  }
}
