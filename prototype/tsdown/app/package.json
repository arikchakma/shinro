{
  "name": "@shinro/prototype-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#shinro/routes": "./.shinro/routes.ts",
    "#shinro/client": "./.shinro/client.ts"
  },
  "exports": {
    "./client": "./.shinro/client.ts"
  },
  "scripts": {
    "generate": "shinro generate",
    "prepare": "shinro generate",
    "dev": "node --watch --watch-path=src --import shinro/generate src/server.ts",
    "dev:tsx": "NODE_OPTIONS=\"--import shinro/generate\" tsx watch --include \"src/routes/**\" src/server.ts",
    "build": "tsdown",
    "start": "node dist/server.mjs",
    "check": "shinro generate --check && tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "catalog:",
    "@hono/zod-validator": "catalog:",
    "hono": "^4.10.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "shinro": "workspace:*",
    "tsdown": "^0.15.0",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
