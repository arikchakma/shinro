---
type Props = {
  step: number;
  title: string;
};

const { step, title } = Astro.props;
---

<h2 class="mb-4 flex items-center gap-2 text-black">
  <span
    class="flex size-5 shrink-0 items-center justify-center rounded-full bg-black text-[0.6875rem] font-medium text-white tabular-nums"
    >{step}</span
  >
  {title}
  <span class="h-px grow bg-zinc-200" aria-hidden="true"></span>
</h2>
