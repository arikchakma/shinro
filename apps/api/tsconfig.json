{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["es2023"],
    "moduleDetection": "force",
    "module": "esnext",
    "moduleResolution": "bundler",
    "rootDirs": [".", "./.daroyan/types"],
    "paths": {
      "daroyan/app": ["../../packages/routes/src/app.ts"],
      "daroyan/entry": ["./.daroyan/types/entry.d.ts"]
    },
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": ["src", "tests", "vite.config.ts", ".daroyan/**/*.d.ts"]
}
