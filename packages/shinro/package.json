{
  "name": "shinro",
  "version": "0.0.2",
  "description": "Opinionated file-based routing for Hono with end-to-end type safety.",
  "keywords": [
    "api",
    "backend",
    "bun",
    "file-based-routing",
    "file-router",
    "filesystem-routing",
    "hono",
    "node",
    "routing",
    "rpc",
    "server",
    "type-safe",
    "typescript",
    "vite-plugin"
  ],
  "homepage": "https://github.com/arikchakma/shinro#readme",
  "bugs": {
    "url": "https://github.com/arikchakma/shinro/issues"
  },
  "license": "MIT",
  "author": "Arik Chakma <arikchangma@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arikchakma/shinro.git",
    "directory": "packages/shinro"
  },
  "bin": {
    "shinro": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "tsconfig.base.json"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./app": {
      "types": "./dist/app.d.mts",
      "import": "./dist/app.mjs"
    },
    "./cli": {
      "types": "./dist/cli.d.mts",
      "import": "./dist/cli.mjs"
    },
    "./package.json": "./package.json",
    "./tsconfig": "./tsconfig.base.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "dev": "vp pack --watch",
    "prepublishOnly": "vp run build",
    "release": "bumpp",
    "test": "vp test"
  },
  "dependencies": {
    "minimatch": "^10.2.5"
  },
  "devDependencies": {
    "@hono/node-server": "catalog:",
    "@hono/zod-validator": "catalog:",
    "@types/node": "^26.1.1",
    "@typescript/native-preview": "catalog:",
    "bumpp": "^11.1.0",
    "hono": "^4.10.0",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "hono": "^4.0.0",
    "vite": "^8.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
