{
  "name": "shinro",
  "version": "0.0.2",
  "description": "Opinionated file-based routing for Hono with end-to-end type safety.",
  "keywords": [
    "api",
    "backend",
    "bun",
    "file-based-routing",
    "file-router",
    "filesystem-routing",
    "hono",
    "node",
    "routing",
    "rpc",
    "server",
    "type-safe",
    "typescript",
    "vite-plugin"
  ],
  "homepage": "https://github.com/arikchakma/shinro#readme",
  "bugs": {
    "url": "https://github.com/arikchakma/shinro/issues"
  },
  "license": "MIT",
  "author": "Arik Chakma <arikchangma@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arikchakma/shinro.git",
    "directory": "packages/shinro"
  },
  "bin": {
    "shinro": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "tsconfig.base.json",
    "tsconfig.emit.json"
  ],
  "type": "module",
  "imports": {
    "#shinro/routes": "./.shinro/routes.ts",
    "#shinro/client": "./.shinro/client.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./app": {
      "types": "./dist/app.d.mts",
      "import": "./dist/app.mjs"
    },
    "./cli": {
      "types": "./dist/cli.d.mts",
      "import": "./dist/cli.mjs"
    },
    "./generate": {
      "types": "./dist/generate.d.mts",
      "import": "./dist/generate.mjs"
    },
    "./watch": {
      "types": "./dist/watch.d.mts",
      "import": "./dist/watch.mjs"
    },
    "./tsdown": {
      "types": "./dist/adapters/tsdown.d.mts",
      "import": "./dist/adapters/tsdown.mjs"
    },
    "./vite": {
      "types": "./dist/adapters/vite.d.mts",
      "import": "./dist/adapters/vite.mjs"
    },
    "./tsconfig": "./tsconfig.base.json",
    "./tsconfig/emit": "./tsconfig.emit.json",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp run generate && vp check",
    "dev": "vp pack --watch",
    "generate": "node src/cli.ts generate",
    "prepublishOnly": "vp run build",
    "pretest": "vp run generate",
    "release": "bumpp",
    "test": "vp test"
  },
  "dependencies": {
    "citty": "^0.2.2",
    "oxc-parser": "^0.90.0"
  },
  "devDependencies": {
    "@hono/node-server": "catalog:",
    "@hono/zod-validator": "catalog:",
    "@types/node": "^26.1.1",
    "@typescript/native-preview": "catalog:",
    "bumpp": "^11.1.0",
    "hono": "^4.10.0",
    "tsdown": "^0.15.0",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "hono": "^4.0.0",
    "tsdown": "^0.15.0",
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "tsdown": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
